# Optional fallback AI config for the browser build.
# Used only when a visitor hasn't entered their own API key.
# WARNING: every VITE_* value is embedded in the public JS bundle and visible to anyone.
# Only use a short-lived / rate-limited key, or point BASE_URL at your own proxy.
#
# PROVIDER must match the API format of BASE_URL:
#   gemini     -> Google Gemini native API
#   openai     -> OpenAI or any OpenAI-compatible /chat/completions endpoint
#   anthropic  -> Anthropic Messages API
#   custom     -> OpenAI-compatible endpoint (format guessed from the URL)

# Gemini example
VITE_AI_FALLBACK_PROVIDER=gemini
VITE_AI_FALLBACK_API_KEY=
VITE_AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VITE_AI_FALLBACK_MODEL=gemini-3.5-flash-lite

# OpenAI-compatible example (e.g. SiliconFlow)
# VITE_AI_FALLBACK_PROVIDER=openai
# VITE_AI_FALLBACK_API_KEY=your_key
# VITE_AI_FALLBACK_BASE_URL=https://api.siliconflow.cn/v1
# VITE_AI_FALLBACK_MODEL=Qwen/Qwen2.5-7B-Instruct
